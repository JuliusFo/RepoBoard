<?xml version="1.0" encoding="utf-8"?>
<!-- Code coverage of the test runs (Microsoft.Testing.Extensions.CodeCoverage), passed to dotnet test as the
     coverage settings by the CI. No double hyphen in these comments: it is invalid XML, and the test platform then
     rejects the whole file. -->
<Configuration>
  <CodeCoverage>
    <!-- Only the libraries the tests are meant for. RepoBoard.App (WPF host) has only the Windows tests of its WebView
         capture (RepoBoard.App.Tests), run without coverage. -->
    <ModulePaths>
      <Include>
        <ModulePath>.*[\\/]RepoBoard\.Core\.dll$</ModulePath>
        <ModulePath>.*[\\/]RepoBoard\.UI\.dll$</ModulePath>
      </Include>
    </ModulePaths>
    <!-- Generated code: the resource classes of the resx files (*Text.g.cs) carry GeneratedCodeAttribute. -->
    <Attributes>
      <Exclude>
        <Attribute>^System\.CodeDom\.Compiler\.GeneratedCodeAttribute$</Attribute>
        <Attribute>^System\.Diagnostics\.CodeAnalysis\.ExcludeFromCodeCoverageAttribute$</Attribute>
      </Exclude>
    </Attributes>
  </CodeCoverage>
</Configuration>
