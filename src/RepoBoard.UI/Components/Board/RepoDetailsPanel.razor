@* The opened row: changes and commit, branches, history; a selected file's diff or commit in place of the last two. *@
@inherits BoardComponent

@{
    var selected = DiffSelection.Resolve(_diffTarget, Status);
}
<div class="details @(selected is not null || _commitId is not null ? "diff-open" : "")">
    <section class="pane">
        <header>
            <h3>@BoardText.Changes</h3>
            @if (Status is { IsClean: false })
            {
                var stageAll = StageAllPaths;
                <button class="btn small ghost" disabled="@(stageAll is null)" @onclick="() => GuardAsync(() => Board.StageAsync(Repo, stageAll!, default))">@BoardText.StageAll</button>
                var unstageAll = UnstageAllPaths;
                <button class="btn small ghost" disabled="@(unstageAll is null)" @onclick="() => GuardAsync(() => Board.UnstageAsync(Repo, unstageAll!, default))">@BoardText.UnstageAll</button>
            }
        </header>
        @if (Repo.Unfinished is { } op)
        {
            var continueBlocker = OperationTools.ContinueBlocker(Repo);
            var name = PullCheck.Name(op.Kind);
            <div class="operation-bar">
                <div class="op-title">@Icons.Warning <span title="@OperationTools.Title(op)">@OperationTools.Title(op)</span></div>
                <div class="op-line">
                    @if (Status is { Conflicts: > 0 } open)
                    {
                        <span class="op-state open">@TextFormat.Plural(open.Conflicts, BoardText.Operation_ConflictsOne, BoardText.Operation_ConflictsOther)</span>
                    }
                    else
                    {
                        <span class="op-state done">@Icons.Check @BoardText.Operation_AllResolved</span>
                    }
                    <span class="spacer"></span>
                    <button class="btn small primary" disabled="@(continueBlocker is not null || Repo.Busy is not null)"
                            title="@(continueBlocker ?? BoardText.Operation_Continue_Hint)"
                            @onclick="() => GuardAsync(() => Board.ContinueAsync(Repo, op.Kind, default))">@BoardText.Operation_Continue</button>
                    @if (OperationTools.CanSkip(op))
                    {
                        <button class="btn small" disabled="@(Status is null)" title="@BoardText.Operation_Skip_Hint" @onclick="() => Ask(QuestionKind.Skip, op)">@BoardText.Operation_Skip</button>
                    }
                    <button class="btn small danger-hover" disabled="@(Status is null)" title="@TextFormat.Format(BoardText.Operation_Abort_Hint, name)"
                            @onclick="() => Ask(QuestionKind.Abort, op)">@BoardText.Operation_Abort</button>
                </div>
            </div>
        }
        @if (Status is null)
        {
            <p class="muted">@BoardText.Loading</p>
        }
        else if (Status.IsClean)
        {
            <p class="muted">@BoardText.NoChanges</p>
        }
        else
        {
            var staged = Status.Changes.Where(c => c.IsStaged).ToList();
            var unstaged = Status.Changes.Where(c => c.IsUnstaged && !c.Conflict).ToList();
            var conflicts = Status.Changes.Where(c => c.Conflict).ToList();
            <div class="files">
                @if (conflicts.Count > 0)
                {
                    <div class="files-head conflicts-head">@TextFormat.Format(BoardText.Conflicts_Head, conflicts.Count)</div>
                    @foreach (var file in conflicts)
                    {
                        var kind = OperationTools.ConflictKind(file);
                        <div class="file conflict @(IsSelected(selected, file, false) ? "selected" : "")" @key="ConflictKey(file)">
                            <span class="letter l-U" title="@kind">U</span>
                            <button class="path" title="@($"{file.Path} – {kind}")" @onclick="() => Select(file, false)"><span>@file.Path</span></button>
                            <button class="btn small ghost" title="@BoardText.Conflict_Open_Hint" disabled="@(file is { Index: 'D', WorkTree: 'D' })"
                                    @onclick="() => Guard(() => Desktop.OpenInEditor(Repo.Path, file.Path))">@Icons.Code @BoardText.Conflict_Open</button>
                            <button class="btn small ghost" title="@BoardText.Conflict_Resolved_Hint" disabled="@(Repo.Busy is not null)"
                                    @onclick="() => MarkResolved(file)">@BoardText.Conflict_Resolved</button>
                        </div>
                    }
                }
                @if (staged.Count > 0)
                {
                    <div class="files-head">@TextFormat.Format(BoardText.Staged_Head, staged.Count)</div>
                    @foreach (var file in staged)
                    {
                        <div class="file @(IsSelected(selected, file, true) ? "selected" : "")" @key="StagedKey(file)">
                            <label title="@Title(file)">
                                <input type="checkbox" checked @onchange="() => GuardAsync(() => Board.UnstageAsync(Repo, [file.Path], default))" />
                                <span class="letter l-@LetterClass(file.Letter(true))">@file.Letter(true)</span>
                            </label>
                            <button class="path" title="@BoardText.Diff_Show_Hint" @onclick="() => Select(file, true)"><span>@file.Path</span></button>
                        </div>
                    }
                }
                @if (unstaged.Count > 0)
                {
                    <div class="files-head">@TextFormat.Format(BoardText.Unstaged_Head, unstaged.Count)</div>
                    @foreach (var file in unstaged)
                    {
                        <div class="file @(IsSelected(selected, file, false) ? "selected" : "")" @key="UnstagedKey(file)">
                            <label title="@Title(file)">
                                <input type="checkbox" @onchange="() => GuardAsync(() => Board.StageAsync(Repo, [file.Path], default))" />
                                <span class="letter l-@LetterClass(file.Letter(false))">@file.Letter(false)</span>
                            </label>
                            <button class="path" title="@BoardText.Diff_Show_Hint" @onclick="() => Select(file, false)"><span>@file.Path</span></button>
                        </div>
                    }
                }
            </div>
        }
        <div class="commit">
            <textarea rows="3" placeholder="@BoardText.CommitMessage_Placeholder" @bind="_message" @bind:event="oninput"
                      disabled="@(Status is null || (Status.IsClean && !_draft.On))"></textarea>
            @{
                var amendBlocker = CommitTools.AmendBlocker(Repo);
            }
            <label class="amend" title="@(amendBlocker ?? BoardText.Amend_Hint)">
                <input type="checkbox" checked="@_draft.On" disabled="@(amendBlocker is not null && !_draft.On)" @onchange="ToggleAmend" />
                @BoardText.Amend_Label
            </label>
            @if (_draft.Note is { } note)
            {
                <p class="amend-note">@note</p>
            }
            @if (Repo.Operation is { } running)
            {
                <p class="amend-note">@TextFormat.Format(BoardText.Operation_CommitNote, PullCheck.Name(running))</p>
            }
            <div class="commit-actions">
                <button class="btn primary" disabled="@(!CanCommit)" @onclick="() => Commit(push: false)">
                    @(_draft.On ? BoardText.Amend_Commit
                        : Status is { Staged: > 0 } ? TextFormat.Format(BoardText.CommitStaged, Status.Staged) : BoardText.CommitAll)
                </button>
                <button class="btn" disabled="@(!CanCommit)" @onclick="() => Commit(push: true)">@(_draft.On ? BoardText.Amend_CommitPush : BoardText.CommitPush)</button>
            </div>
        </div>
    </section>

    @if (selected is { } diff)
    {
        <DiffPanel @ref="_diffPanel" Repo="Repo" Change="diff.Change" Staged="diff.Staged" OnClose="CloseDiff" />
    }
    else if (_commitId is { } commitId)
    {
        <CommitPanel @ref="_commitPanel" Repo="Repo" Id="@commitId" OnClose="CloseCommit" OnOpen="OpenCommit" />
    }
    else
    {
        <section class="pane">
            <header>
                <h3>@BoardText.Branches</h3>
            </header>
            <form class="new-branch" @onsubmit="CreateBranch">
                <input placeholder="@BoardText.NewBranch_Placeholder" @bind="_newBranch" @bind:event="oninput" />
                <button class="btn small" type="submit" disabled="@string.IsNullOrWhiteSpace(_newBranch)">@Icons.Plus @BoardText.NewBranch_Create</button>
            </form>
            @if (Repo.Details is { } details)
            {
                var mergeBlocker = OperationTools.MergeBlocker(Repo);
                var current = Status?.Branch ?? "HEAD";
                <div class="branch-list">
                    @foreach (var branch in details.Branches)
                    {
                        <div class="branch-item @(branch.IsCurrent ? "current" : "") @(branch.IsRemote ? "remote" : "")">
                            <span class="b-name" title="@branch.Name">@(branch.IsCurrent ? Icons.Check : Icons.Branch) @branch.Name</span>
                            <span class="b-track">@branch.Track</span>
                            <span class="b-when">@branch.LastCommit</span>
                            @if (!branch.IsCurrent)
                            {
                                @* Merge and rebase show on hover (WP-07): with every branch at once the list would be all buttons. *@
                                <span class="b-actions">
                                    <button class="btn small ghost b-more" disabled="@(mergeBlocker is not null)"
                                            title="@(mergeBlocker ?? TextFormat.Format(BoardText.Branch_Merge_Hint, branch.Name, current))"
                                            @onclick="() => GuardAsync(() => Board.MergeAsync(Repo, branch, default))">@BoardText.Branch_Merge</button>
                                    <button class="btn small ghost b-more" disabled="@(mergeBlocker is not null)"
                                            title="@(mergeBlocker ?? TextFormat.Format(BoardText.Branch_Rebase_Hint, branch.Name, current))"
                                            @onclick="() => GuardAsync(() => Board.RebaseAsync(Repo, branch, default))">@BoardText.Branch_Rebase</button>
                                    <button class="btn small ghost" title="@BoardText.Switch_Hint" @onclick="() => GuardAsync(() => Board.SwitchAsync(Repo, branch, default))">@BoardText.Switch</button>
                                </span>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="muted">@BoardText.Loading</p>
            }
        </section>

        <section class="pane">
            <header>
                <h3>@BoardText.RecentCommits</h3>
                <label class="log-all" title="@BoardText.History_AllBranches_Hint">
                    <input type="checkbox" checked="@Repo.LogAll"
                           @onchange="e => GuardAsync(() => Board.SetLogAsync(Repo, Repo.LogLength, e.Value is true, default))" />
                    @BoardText.History_AllBranches
                </label>
            </header>
            @if (Repo.Details is null)
            {
                <p class="muted">@BoardText.Loading</p>
            }
            else if (Repo.Details.Log.Count == 0)
            {
                <p class="muted">@BoardText.NoCommits</p>
            }
            else
            {
                var history = Repo.Details;
                var lanes = GraphDrawing.Lanes(history.Graph);
                <div class="log">
                    @for (var i = 0; i < history.Log.Count; i++)
                    {
                        var commit = history.Log[i];
                        <HistoryRow @key="commit.Id" Commit="commit" Graph="history.Graph[i]" Lanes="lanes"
                                    OnSelect="() => OpenCommit(commit.Id)" />
                    }
                    @if (history.HasMore && Repo.LogLength < BoardService.MaxLogLength)
                    {
                        <button class="btn small ghost load-more"
                                @onclick="() => GuardAsync(() => Board.SetLogAsync(Repo, Repo.LogLength + BoardService.LogStep, Repo.LogAll, default))">
                            @TextFormat.Format(BoardText.History_LoadMore, BoardService.LogStep)
                        </button>
                    }
                </div>
            }
        </section>
    }
</div>

@if (_question is { } question)
{
    <ConfirmDialog Title="@question.Title" Text="@question.Text" Files="question.Files" ConfirmLabel="@question.Confirm"
                   Danger="question.Kind != QuestionKind.Markers" CancelLabel="@(question.Kind == QuestionKind.Markers ? null : BoardText.Dialog_Back)"
                   OnConfirm="Confirm" OnCancel="() => _question = null" />
}

@code {
    [Parameter, EditorRequired] public RepoState Repo { get; set; } = null!;

    private string _message = "";
    private string _newBranch = "";

    /// <summary>The file whose diff is open (page state only); resolved against each new status.</summary>
    private DiffTarget? _diffTarget;

    private DiffPanel? _diffPanel;

    /// <summary>The commit of the history whose details are open (WP-09, page state only); a file's diff wins.</summary>
    private string? _commitId;

    private CommitPanel? _commitPanel;

    /// <summary>"Amend last commit" (WP-09): for which HEAD, with which message (review WP-09).</summary>
    private readonly AmendDraft _draft = new();

    /// <summary>A commit or amend of this box runs: the new HEAD it makes is no other session's.</summary>
    private bool _committing;

    /// <summary>Only a click on a file moves the focus to its diff (for Esc) – never a diff that a new status brought.</summary>
    private bool _focusDiff;

    private bool _focusCommit;

    protected override void OnParametersSet()
    {
        _diffTarget = DiffSelection.Next(_diffTarget, Status);
        if (!_committing)
        {
            // Another commit is the last one now: the message filled in belongs to the one before.
            _message = _draft.Follow(_message, Status?.Head);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusDiff)
        {
            _focusDiff = false;
            if (_diffPanel is { } panel)
            {
                await panel.FocusAsync();
            }
        }

        if (_focusCommit)
        {
            _focusCommit = false;
            if (_commitPanel is { } panel)
            {
                await panel.FocusAsync();
            }
        }
    }

    private RepoStatus? Status => Repo.Status;

    // While an operation is unfinished, "Continue" commits (WP-07): a commit in the middle of a rebase would be one too many.
    private bool CanCommit => !string.IsNullOrWhiteSpace(_message) && Repo.Busy is null && Repo.Operation is null
        && (_draft.On
            ? CommitTools.AmendBlocker(Repo) is null && Status is { Conflicts: 0 }
            : Status is { IsClean: false, Conflicts: 0 });

    // A row per file and side (a partly staged file is in both lists, which share one parent): without a key Blazor reuses
    // the row of a file that moved to the other list for the next file – with the checkbox the click left ticked (E2E
    // review WP-05; a click on it would have staged that next file).
    private static string StagedKey(FileChange file) => "s:" + file.Path;
    private static string UnstagedKey(FileChange file) => "u:" + file.Path;
    private static string ConflictKey(FileChange file) => "c:" + file.Path;

    /// <summary>
    /// What "Stage all" stages: everything (empty) – but with conflicts only the other files, a conflict is marked resolved on
    /// its own (WP-07); null if nothing else is left.
    /// </summary>
    private IReadOnlyList<string>? StageAllPaths =>
        Status is not { Conflicts: > 0 } status ? []
        : status.Changes.Where(c => c.IsUnstaged && !c.Conflict).Select(c => c.Path).ToList() is { Count: > 0 } others ? others
        : null;

    /// <summary>
    /// What "Unstage all" unstages: everything (empty) – but with conflicts only the staged files: unstaging a conflicted file
    /// would put HEAD's version into the index and let "Continue" drop the other side (WP-07); null if nothing is staged.
    /// </summary>
    private IReadOnlyList<string>? UnstageAllPaths =>
        Status is not { Conflicts: > 0 } status ? []
        : status.Changes.Where(c => c.IsStaged).Select(c => c.Path).ToList() is { Count: > 0 } staged ? staged
        : null;

    private enum QuestionKind { Abort, Skip, Markers }

    /// <summary>An open question (WP-07) with what the board checks again when it is confirmed (ADR 0014).</summary>
    private sealed record Question(QuestionKind Kind, string Title, string Text, string Confirm, IReadOnlyList<string>? Files, string Key, string? Path);

    private Question? _question;

    /// <summary>Abort or skip: asks with the files that go back, as they are now; the board acts only if they still are.</summary>
    private void Ask(QuestionKind kind, OperationInfo op)
    {
        if (Status is not { } status)
        {
            return;
        }

        var name = PullCheck.Name(op.Kind);
        var files = BoardService.DiscardedFiles(status);
        _question = kind == QuestionKind.Abort
            ? new Question(kind, TextFormat.Format(BoardText.Operation_AbortTitle, name), TextFormat.Format(BoardText.Operation_AbortText, name),
                TextFormat.Format(BoardText.Operation_AbortConfirm, name), files, op.Key, null)
            : new Question(kind, BoardText.Operation_SkipTitle, TextFormat.Format(BoardText.Operation_SkipText, OperationTools.SkippedCommit(op)),
                BoardText.Operation_SkipConfirm, files, op.Key, null);
    }

    /// <summary>"Resolved": stages the file, after a question if git still finds conflict markers in it.</summary>
    private Task MarkResolved(FileChange file) => GuardAsync(async () =>
    {
        if (await Board.HasConflictMarkersAsync(Repo, file.Path, default) == true)
        {
            _question = new Question(QuestionKind.Markers, BoardText.Conflict_MarkersTitle, TextFormat.Format(BoardText.Conflict_MarkersText, file.Path),
                BoardText.Conflict_MarkersConfirm, null, "", file.Path);
            return;
        }

        await Board.MarkResolvedAsync(Repo, file.Path, default);
    });

    private Task Confirm() => GuardAsync(async () =>
    {
        if (_question is not { } question)
        {
            return;
        }

        _question = null;
        await (question.Kind switch
        {
            QuestionKind.Abort => Board.AbortAsync(Repo, question.Key, question.Files!, default),
            QuestionKind.Skip => Board.SkipAsync(Repo, question.Key, question.Files!, default),
            _ => Board.MarkResolvedAsync(Repo, question.Path!, default),
        });
    });

    private static bool IsSelected((FileChange Change, bool Staged)? selected, FileChange file, bool staged) =>
        selected is { } s && s.Staged == staged && s.Change.Path == file.Path;

    /// <summary>A click on a file opens its diff; on the open one, closes it.</summary>
    private void Select(FileChange file, bool staged)
    {
        var target = new DiffTarget(file.Path, staged);
        _diffTarget = _diffTarget == target ? null : target;
        _focusDiff = _diffTarget is not null;
    }

    private void CloseDiff() => _diffTarget = null;

    /// <summary>A click on a commit of the history, or on a parent in the open commit, shows its details.</summary>
    private void OpenCommit(string id)
    {
        _diffTarget = null;
        _commitId = id;
        _focusCommit = true;
    }

    private void CloseCommit() => _commitId = null;

    /// <summary>Amend starts from the last commit's message; unticked, an unedited one goes again.</summary>
    private Task ToggleAmend(ChangeEventArgs e) => GuardAsync(async () =>
    {
        if (e.Value is not true)
        {
            _message = _draft.Untick(_message);
            return;
        }

        _draft.Tick(Status?.Head);
        if (string.IsNullOrWhiteSpace(_message) && await Board.HeadMessageAsync(Repo, default) is { } message)
        {
            _message = _draft.Fill(_message, Status?.Head, message);
        }
    });

    private static string Title(FileChange file) =>
        file.OriginalPath is { } from ? $"{from} → {file.Path}" : file.Path;

    /// <summary>A CSS class for the status letter: '?' is no valid class character.</summary>
    private static string LetterClass(char letter) => letter == '?' ? "new" : letter.ToString();

    private Task Commit(bool push) => GuardAsync(async () =>
    {
        var amend = _draft.On;
        _committing = true;
        try
        {
            var done = await Board.CommitAsync(Repo, _message.Trim(), push, default, amend, amend ? _draft.Head : null);
            // An amend whose push failed is still done: HEAD is the new commit.
            if (done || (amend && Status?.Head != _draft.Head))
            {
                _message = "";
                _draft.Done();
            }
        }
        finally
        {
            _committing = false;
        }
    });

    private Task CreateBranch() => GuardAsync(async () =>
    {
        if (await Board.CreateBranchAsync(Repo, _newBranch.Trim(), default))
        {
            _newBranch = "";
        }
    });
}
