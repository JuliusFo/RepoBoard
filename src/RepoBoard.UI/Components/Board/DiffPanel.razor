@* The diff of one changed file in the opened row (WP-05, ADR 0008): git's own diff, inline, read again with each new status. *@
@inherits BoardComponent

<section class="pane diff-pane" tabindex="-1" @ref="_pane" @onkeydown="OnKeyDown">
    <header>
        <h3 class="diff-title" title="@Change.Path">
            <span class="path">@Change.Path</span>
        </h3>
        <span class="diff-side @(Staged ? "staged" : "")">@(Staged ? BoardText.Diff_Staged : BoardText.Diff_Unstaged)</span>
        <button class="btn small ghost icon-only" title="@BoardText.Diff_Close_Hint" @onclick="OnClose">@Icons.Close</button>
    </header>
    @if (Change.OriginalPath is { } from)
    {
        <p class="muted diff-note">@TextFormat.Format(BoardText.Diff_Renamed, from)</p>
    }

    @if (Change.Conflict)
    {
        <p class="muted">@BoardText.Diff_Conflict</p>
    }
    else if (Change.IsNestedRepository)
    {
        <p class="muted">@BoardText.Diff_NestedRepository</p>
    }
    else
    {
        <DiffBody Diff="_diff" Error="@_error">
            <HunkTools Context="hunkIndex">
                @{ var picked = _selection.CountIn(hunkIndex); }
                <button class="btn small hunk-stage" disabled="@(_staging || !_current || IsCutOff(hunkIndex))"
                        title="@(IsCutOff(hunkIndex) ? SyncText.Hunk_Incomplete : picked > 0 ? BoardText.Diff_StageLines_Hint : BoardText.Diff_StageHunk_Hint)"
                        @onclick="() => GuardAsync(() => StageAsync(hunkIndex))">@HunkLabel(picked)</button>
            </HunkTools>
            <Line Context="at">
                <DiffLineView Line="at.Hunk.Lines[at.LineIndex]" Picked="_selection.IsPicked(at.HunkIndex, at.LineIndex)"
                              OnPick="shift => Pick(at.Hunk, at.HunkIndex, at.LineIndex, shift)" />
            </Line>
        </DiffBody>
    }
</section>

@code {
    [Parameter, EditorRequired] public RepoState Repo { get; set; } = null!;
    [Parameter, EditorRequired] public FileChange Change { get; set; } = null!;
    [Parameter] public bool Staged { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private ElementReference _pane;
    private FileDiff? _diff;
    private string? _error;

    // What the shown diff was read for: a new status (every refresh, also when only the file's content changed), another
    // file or the other side reads it again; any other render of the page does not.
    private (RepoStatus? Status, string Path, bool Staged)? _readFor;
    private int _reads;

    // The lines picked for staging (WP-25) and whether a hunk is being staged right now.
    private readonly LineSelection _selection = new();
    private bool _staging;

    // The shown diff belongs to the latest status. Not while the next one loads: a hunk staged from it right after another
    // one would only meet "the file changed" (second review pass WP-25).
    private bool _current;

    // What the markup last showed: the page renders on every change of any repository, the lines only when this changes
    // (review WP-05 – up to 5,000 lines).
    private (FileDiff? Diff, string? Error, FileChange Change, bool Staged, int Picks, bool Staging, bool Current)? _shown;

    protected override bool ShouldRender()
    {
        var now = (_diff, _error, Change, Staged, _selection.Version, _staging, _current);
        if (_shown == now)
        {
            return false;
        }

        _shown = now;
        return true;
    }

    protected override void OnParametersSet()
    {
        var key = (Repo.Status, Change.Path, Staged);
        if (_readFor == key || Change.Conflict || Change.IsNestedRepository)
        {
            return;
        }

        var otherFile = _readFor is not { } before || before.Path != key.Path || before.Staged != key.Staged;
        _readFor = key;
        if (otherFile)
        {
            // Another file: no stale diff while the new one loads. The same file keeps its diff until the new one is there.
            _diff = null;
            _error = null;
            _selection.Clear();
        }

        var read = ++_reads;
        _current = false;
        var change = Change;
        var staged = Staged;
        Fire(async () =>
        {
            try
            {
                var (diff, error) = await Board.DiffAsync(Repo, change, staged, default);
                if (read == _reads)
                {
                    if (diff is not null)
                    {
                        _selection.KeepFor(_diff, diff);
                    }
                    else
                    {
                        _selection.Clear();
                    }

                    (_diff, _error) = (diff, error);
                }
            }
            finally
            {
                // Also after an unexpected error (reported by the guard): the buttons do not stay off until the next status.
                // Staging still compares with a fresh diff (third review pass WP-25).
                if (read == _reads)
                {
                    _current = true;
                    StateHasChanged();
                }
            }
        });
    }

    /// <summary>The last hunk of a diff cut off at the line limit: its patch would miss the rest (WP-25).</summary>
    private bool IsCutOff(int hunk) => _diff is { IsTruncated: true } diff && hunk == diff.Hunks.Count - 1;

    private string HunkLabel(int picked) => (Staged, picked > 0) switch
    {
        (false, false) => BoardText.Diff_StageHunk,
        (true, false) => BoardText.Diff_UnstageHunk,
        (false, true) => TextFormat.Format(BoardText.Diff_StageLines, picked),
        (true, true) => TextFormat.Format(BoardText.Diff_UnstageLines, picked),
    };

    // Not while a hunk is being staged: its success clears the selection, a pick made meanwhile would go with it (review WP-25).
    private void Pick(DiffHunk hunk, int hunkIndex, int line, bool shift)
    {
        if (!_staging)
        {
            _selection.Click(hunk, hunkIndex, line, shift);
        }
    }

    /// <summary>Stages (unstages on the staged side) the picked lines of the hunk, or all of it with none picked.</summary>
    private async Task StageAsync(int hunk)
    {
        if (_diff is not { } diff || !_current)
        {
            return;
        }

        var lines = _selection.CountIn(hunk) > 0 ? _selection.Lines.ToHashSet() : null;
        _staging = true;
        try
        {
            if (await Board.StageHunkAsync(Repo, Change, diff, Staged, hunk, lines, default))
            {
                _selection.Clear();
            }
        }
        finally
        {
            _staging = false;
            // The board read the new status before returning; until this panel reads its diff, the buttons stay off.
            if (_readFor is not { } readFor || !ReferenceEquals(readFor.Status, Repo.Status))
            {
                _current = false;
            }
        }
    }

    /// <summary>Esc closes the diff: the keys reach the pane only while it has the focus. Called after a click on a file.</summary>
    public ValueTask FocusAsync() => _pane.FocusAsync(preventScroll: true);

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await OnClose.InvokeAsync();
        }
    }
}
