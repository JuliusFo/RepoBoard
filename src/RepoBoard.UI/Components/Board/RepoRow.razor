@* One repository – or one of its linked worktrees, indented below it (WP-04) –: the row (a click opens the details), an
   error line below it if the last operation failed. *@
@inherits BoardComponent

<div class="row repo @(Expanded ? "open" : "") @(Repo.IsWorktree ? "worktree" : "")" tabindex="-1" @ref="_row" @onclick="OnToggle">
    <span class="chev">@(Expanded ? Icons.ChevronDown : Icons.ChevronRight)</span>

    <span class="name">
        <span class="name-line">
            <strong>@Repo.Name</strong>
            @if (Repo.Worktrees.Count > 0)
            {
                <button class="badge worktrees @(WorktreesOpen ? "open" : "")" title="@TextFormat.Format(BoardText.Worktrees_Hint, Repo.Worktrees.Count)"
                        @onclick="OnToggleWorktrees" @onclick:stopPropagation>@Icons.Worktrees @Repo.Worktrees.Count</button>
            }
            @if (Repo.IsClaudeWorktree)
            {
                <span class="badge claude" title="@BoardText.Worktree_Claude_Hint">@BoardText.Worktree_Claude</span>
            }
            @if (Repo.Worktree?.Locked is { } locked)
            {
                <span class="badge warn" title="@(locked.Length > 0 ? TextFormat.Format(BoardText.Worktree_Locked_Reason, locked) : BoardText.Worktree_Locked_Hint)">@Icons.Locked @BoardText.Worktree_Locked</span>
            }
        </span>
        <small title="@Repo.Path">@Repo.Path</small>
    </span>

    <span class="branch">
        @if (Repo.Missing)
        {
            <span class="badge danger">@BoardText.Missing</span>
        }
        else if (Status is null)
        {
            <span class="muted">…</span>
        }
        else if (Status.IsDetached)
        {
            <span class="badge warn" title="@BoardText.Detached_Hint">@TextFormat.Format(BoardText.Detached, Status.Head?[..Math.Min(7, Status.Head.Length)])</span>
        }
        else
        {
            <span class="badge branch-name @(IsMainBranch(Status.Branch) ? "main" : "feature")" title="@Status.Branch">@Icons.Branch <span>@Status.Branch</span></span>
        }
        @if (Repo.Operation is { } op)
        {
            <span class="badge warn">@TextFormat.Format(BoardText.OperationRunning, PullCheck.Name(op))</span>
        }
    </span>

    <span class="sync">
        @if (Status is { IsDetached: false } s)
        {
            if (!s.HasUpstream)
            {
                <span class="muted" title="@BoardText.NoUpstream_Hint">@BoardText.NoUpstream</span>
            }
            else if (s.UpstreamGone)
            {
                <span class="muted" title="@TextFormat.Format(BoardText.UpstreamGone_Hint, s.Upstream)">@BoardText.UpstreamGone</span>
            }
            else
            {
                if (s.Ahead > 0)
                {
                    <span class="ahead" title="@TextFormat.Plural(s.Ahead, BoardText.Ahead_HintOne, BoardText.Ahead_HintOther, s.Upstream)">@Icons.Push@s.Ahead</span>
                }
                if (s.Behind > 0)
                {
                    <span class="behind" title="@TextFormat.Plural(s.Behind, BoardText.Behind_HintOne, BoardText.Behind_HintOther, s.Upstream)">@Icons.Pull@s.Behind</span>
                }
                if (s is { Ahead: 0, Behind: 0 })
                {
                    <span class="ok" title="@TextFormat.Format(BoardText.UpToDate_Hint, s.Upstream)">@Icons.Check @BoardText.UpToDate</span>
                }
            }
        }
        @if (Repo.AutoPullBlocked is { } blocked)
        {
            <span class="blocked" title="@TextFormat.Format(SyncText.AutoPullSkipped, blocked)">@Icons.Warning</span>
        }
    </span>

    <span class="changes">
        @if (Status is { IsClean: true })
        {
            <span class="muted">@BoardText.Clean</span>
        }
        else if (Status is not null)
        {
            if (Status.Conflicts > 0)
            {
                <span class="cnt conflict" title="@BoardText.Conflicts_Hint">!@Status.Conflicts</span>
            }
            if (Status.Staged > 0)
            {
                <span class="cnt staged" title="@BoardText.Staged_Hint">+@Status.Staged</span>
            }
            if (Status.Modified > 0)
            {
                <span class="cnt modified" title="@BoardText.Modified_Hint">~@Status.Modified</span>
            }
            if (Status.Untracked > 0)
            {
                <span class="cnt untracked" title="@BoardText.Untracked_Hint">?@Status.Untracked</span>
            }
        }
    </span>

    <span class="fetched @(RelativeTime.IsStale(Repo.LastFetch, Now) ? "stale" : "")" title="@RelativeTime.Exact(Repo.LastFetch)">@RelativeTime.Text(Repo.LastFetch, Now)</span>

    @if (Repo.IsWorktree)
    {
        @* No auto-sync of its own (decision of the user): a fetch of the repository brings the worktree's refs too. *@
        <span></span>
        <span></span>
    }
    else
    {
        <span class="switch"><Toggle Value="Repo.Entry.AutoFetch" Title="@BoardText.Col_AutoFetch_Hint" OnChange="v => GuardAsync(() => Board.SetAutoFetchAsync(Repo, v, default))" /></span>
        <span class="switch"><Toggle Value="Repo.Entry.AutoPull" Title="@BoardText.Col_AutoPull_Hint" OnChange="v => GuardAsync(() => Board.SetAutoPullAsync(Repo, v, default))" /></span>
    }

    <span class="actions" @onclick:stopPropagation>
        @if (Repo.Busy is { } busy)
        {
            <span class="spinner"></span><span class="busy-text">@busy …</span>
        }
        else if (Repo.Missing)
        {
            @* Nothing to run in a folder that is gone (review 0.4.0, A17); a worktree's removal cleans up git's data about it. *@
        }
        else
        {
            @if (!Repo.IsWorktree)
            {
                <button class="btn small" title="@BoardText.Fetch_Hint" @onclick="() => GuardAsync(() => Board.FetchAsync(Repo, default))">@Icons.Fetch</button>
            }
            <button class="btn small @(Status is { Behind: > 0 } ? "hot" : "")" title="@BoardText.Pull_Hint" @onclick="() => GuardAsync(() => Board.PullAsync(Repo, default))">@Icons.Pull @BoardText.Pull</button>
            <button class="btn small @(BoardFilter.HasToPush(Status) ? "hot" : "")" title="@BoardText.Push_Hint" @onclick="() => GuardAsync(() => Board.PushAsync(Repo, default))">@Icons.Push @BoardText.Push</button>
        }
        <button class="btn small ghost" title="@BoardText.OpenFolder_Hint" disabled="@Repo.Missing" @onclick="() => Guard(() => Desktop.OpenFolder(Repo.Path))">@Icons.Folder</button>
        <button class="btn small ghost" title="@BoardText.OpenTerminal_Hint" disabled="@Repo.Missing" @onclick="() => Guard(() => Desktop.OpenTerminal(Repo.Path))">@Icons.Terminal</button>
        <button class="btn small ghost" title="@BoardText.OpenEditor_Hint" disabled="@Repo.Missing" @onclick="() => Guard(() => Desktop.OpenInEditor(Repo.Path))">@Icons.Code</button>
        @if (Repo.IsWorktree)
        {
            <button class="btn small ghost danger-hover" title="@BoardText.Worktree_Remove_Hint" disabled="@(Repo.Busy is not null)" @onclick="OnRemoveWorktree">@Icons.Trash</button>
        }
        else
        {
            <button class="btn small ghost danger-hover" title="@BoardText.Remove_Hint" @onclick="() => GuardAsync(() => Board.RemoveAsync(Repo, default))">@Icons.RemoveFromBoard</button>
        }
    </span>
</div>

@if (Repo.Error is { } error)
{
    <div class="row-error">
        @Icons.Warning <span>@error</span>
        <button class="btn small ghost" title="@BoardText.HideError_Hint" @onclick="() => Board.ClearError(Repo)">@Icons.Close</button>
    </div>
}

@if (Expanded)
{
    <RepoDetailsPanel Repo="Repo" Now="Now" />
}

@code {
    [Parameter, EditorRequired] public RepoState Repo { get; set; } = null!;
    [Parameter] public DateTimeOffset Now { get; set; }
    [Parameter] public bool Expanded { get; set; }
    [Parameter] public EventCallback OnToggle { get; set; }

    /// <summary>A repository's worktree rows are shown (its count badge is a toggle).</summary>
    [Parameter] public bool WorktreesOpen { get; set; }

    [Parameter] public EventCallback OnToggleWorktrees { get; set; }

    /// <summary>A worktree's remove button: the shell asks first (ADR 0010).</summary>
    [Parameter] public EventCallback OnRemoveWorktree { get; set; }

    /// <summary>Changes when the row is to come into view (a click on a notification); 0 = no request.</summary>
    [Parameter] public int ScrollRequest { get; set; }

    private ElementReference _row;
    private int _scrolled;

    private RepoStatus? Status => Repo.Status;

    /// <summary>Focusing scrolls the row into view – no script needed (the page allows none inline).</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (ScrollRequest != 0 && ScrollRequest != _scrolled)
        {
            _scrolled = ScrollRequest;
            await GuardAsync(() => _row.FocusAsync().AsTask());
        }
    }

    /// <summary>The usual long-lived branches stay grey; any other branch is coloured, so a forgotten feature branch stands out.</summary>
    private static bool IsMainBranch(string? name) => name is "main" or "master" or "develop" or "dev";
}
