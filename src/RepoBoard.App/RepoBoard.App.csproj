<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- Thin WPF host: generic host, logging, window chrome and the BlazorWebView. The UI lives in RepoBoard.UI. -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- BlazorWebView's WebView2CompositionControl needs the WinRT projection; with net10.0-windows it crashes at start
         (FerretSharp ADR 0004). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>RepoBoard.App</RootNamespace>
    <AssemblyName>RepoBoard</AssemblyName>
    <!-- Per-monitor DPI awareness, see the comment in the manifest. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>RepoBoard.ico</ApplicationIcon>
    <!-- Only for NotifyIcon, the icon in the notification area (ADR 0006); WPF has none. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WinForms' analyzer wants the DPI mode from Application.SetHighDpiMode instead of the manifest – that is for a WinForms
         app; here WPF owns the process and the manifest sets it (see app.manifest). -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <!-- WinForms' implicit usings would make Application, MessageBox, Color … ambiguous with WPF: WinForms types are named. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- Program, window and notification-area icon; drawn by tools/icon/New-AppIcon.ps1. -->
  <ItemGroup>
    <Resource Include="RepoBoard.ico" />
  </ItemGroup>

  <!-- Own entry point (Program.Main): the instance lock before WPF starts. -->
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RepoBoard.Core\RepoBoard.Core.csproj" />
    <ProjectReference Include="..\RepoBoard.UI\RepoBoard.UI.csproj" />
  </ItemGroup>

</Project>
