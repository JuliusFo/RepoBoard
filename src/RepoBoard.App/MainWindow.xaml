<Window x:Class="RepoBoard.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
        xmlns:ui="clr-namespace:RepoBoard.UI;assembly=RepoBoard.UI"
        Title="RepoBoard"
        Width="1480"
        Height="860"
        MinWidth="1000"
        MinHeight="500"
        Icon="RepoBoard.ico"
        WindowStartupLocation="CenterScreen">
    <blazor:BlazorWebView x:Name="WebView" HostPage="wwwroot\index.html">
        <blazor:BlazorWebView.RootComponents>
            <blazor:RootComponent Selector="#app" ComponentType="{x:Type ui:Shell}" />
        </blazor:BlazorWebView.RootComponents>
    </blazor:BlazorWebView>
</Window>
