<Project Sdk="Microsoft.NET.Sdk">

  <!-- Git access, repository list, auto-sync. No UI, no Windows-only APIs: builds and tests under Linux (CLAUDE.md §4). -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>RepoBoard.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RepoBoard.Core.Tests" />
    <!-- The UI tests set a repository's state as the board does. -->
    <InternalsVisibleTo Include="RepoBoard.UI.Tests" />
  </ItemGroup>

</Project>
